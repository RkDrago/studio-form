// STUDIOFORM production data model.
//
// The running app currently serves temp data from lib/data.ts. This schema is
// the drop-in replacement: `npx prisma db push`, then swap the functions in
// lib/data.ts for PrismaClient calls. Field names and the API contract already
// match, so nothing else changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  Commercial
  Residential
  Hospitality
  Retail
}

enum Status {
  PUBLISHED
  DRAFT
}

enum MediaType {
  IMAGE
  VIDEO
}

model Project {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  category    Category
  location    String
  sizeSqft    String
  year        String
  clientName  String
  description String    @db.Text
  scope       String[]
  materials   String[]
  coverUrl    String
  videoUrl    String?
  tags        String[]
  status      Status    @default(PUBLISHED)
  featured    Boolean   @default(false)
  media       Media[]
  createdAt   DateTime  @default(now())

  @@index([category, status])
}

model Media {
  id           String    @id @default(cuid())
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  url          String
  thumbnailUrl String?
  webpUrl      String?
  type         MediaType
  size         Int
  order        Int
  createdAt    DateTime  @default(now())

  @@index([projectId, order])
}
