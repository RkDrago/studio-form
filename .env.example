# ---------------------------------------------------------------------------
# STUDIOFORM env
# The app runs fully on temp data with NO env set. Fill these in to switch the
# upload engine from the local temp store to real direct-to-S3 uploads.
# ---------------------------------------------------------------------------

# Database (Prisma + PostgreSQL) - only needed for the Prisma-backed build
DATABASE_URL="postgresql://user:pass@localhost:5432/studioform"

# S3 direct upload (leave blank to use the built-in temp upload store)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET="studioform-media"
S3_CDN_URL="https://cdn.studioform.in"

# Video (Mux)
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""

# Auth (NextAuth) - admin studio protection
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
